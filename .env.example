# Sentrexa environment configuration - EXAMPLE / TEMPLATE
# Copy to `.env` (which is gitignored) and fill in real values.
# NEVER commit a real .env or real credentials.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
SENTREXA_ENV=dev                       # dev | ci | prod

# ---------------------------------------------------------------------------
# Database (PostgreSQL / Neon)
# ---------------------------------------------------------------------------
# Admin / bootstrap connection - owns the database, can CREATE ROLE.
# Used ONLY by sql bootstrap scripts, never by the running app.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Least-privilege application roles (created by the bootstrap script in Phase 2).
# Read/write role: ingestion + detection + alerting writers.
DATABASE_URL_RW=postgresql+psycopg://sentrexa_rw:CHANGE_ME@HOST/DBNAME?sslmode=require
# Read-only role: Streamlit dashboard + reporting.
DATABASE_URL_RO=postgresql+psycopg://sentrexa_ro:CHANGE_ME@HOST/DBNAME?sslmode=require

# ---------------------------------------------------------------------------
# Simulation (Phase 1)
# ---------------------------------------------------------------------------
SIM_SEED=1337
SIM_BENIGN_EVENTS=6000                 # approx count of benign background events per run
SIM_WINDOW_HOURS=168                   # time span the run covers, ending "now"
SIM_OUTPUT_DIR=data/raw
SIM_OFF_HOURS_START=20                 # local hour off-hours window opens (inclusive)
SIM_OFF_HOURS_END=6                    # local hour off-hours window closes (exclusive)
SIM_BRUTE_FORCE_ATTEMPTS=12            # failed auths the seeded brute-force burst emits
SIM_BRUTE_FORCE_WINDOW_MIN=3          # minutes the burst is spread across
SIM_MALFORMED_COUNT=0                  # deliberately corrupt lines to inject (Phase 2 testing)

# ---------------------------------------------------------------------------
# Dashboard auth (Phase 6) - streamlit-authenticator credential gate
# ---------------------------------------------------------------------------
DASHBOARD_AUTH_COOKIE_KEY=CHANGE_ME_RANDOM_STRING
DASHBOARD_AUTH_COOKIE_NAME=sentrexa_auth
DASHBOARD_AUTH_COOKIE_EXPIRY_DAYS=7
DASHBOARD_AUTH_USERNAME=analyst
DASHBOARD_AUTH_NAME=SOC Analyst
# bcrypt hash - generate with:  python -m dashboard.hash_password 'your password'
DASHBOARD_AUTH_PASSWORD_HASH=CHANGE_ME

# ---------------------------------------------------------------------------
# BI / BigQuery (Phase 7)
# ---------------------------------------------------------------------------
# Keyless authentication - no service-account key file anywhere:
#   local : gcloud auth application-default login   (your own account)
#   CI    : Workload Identity Federation (google-github-actions/auth@v2)
GCP_PROJECT_ID=
BIGQUERY_DATASET=analytics
BIGQUERY_LOCATION=US
