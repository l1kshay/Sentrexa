# Copy to .streamlit/secrets.toml (gitignored) for local runs, OR paste these
# keys into the Streamlit Community Cloud "Secrets" box when deploying.
# app.py mirrors every string key here into os.environ, so the names match .env.

DATABASE_URL_RO = "postgresql+psycopg://sentrexa_ro:PASSWORD@HOST/sentrexa?sslmode=require"

DASHBOARD_AUTH_COOKIE_KEY = "CHANGE_ME_RANDOM_STRING"
DASHBOARD_AUTH_COOKIE_NAME = "sentrexa_auth"
DASHBOARD_AUTH_COOKIE_EXPIRY_DAYS = "7"
DASHBOARD_AUTH_USERNAME = "analyst"
DASHBOARD_AUTH_NAME = "SOC Analyst"
DASHBOARD_AUTH_PASSWORD_HASH = "PASTE_BCRYPT_HASH_FROM  python -m dashboard.hash_password"
